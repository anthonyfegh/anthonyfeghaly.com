<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Session 4 workbook</title>
<style>
@font-face{font-family:'Outfit';font-style:normal;font-weight:100 900;font-display:swap;src:url(data:font/ttf;base64,) format('truetype')}
@font-face{font-family:'Overpass Mono';font-style:normal;font-weight:300 700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
:root{
  --desk:#E7E9F0;
  --page:#FFFFFF;
  --ink:#161A2E;
  --ink-2:#4A5167;
  --ink-3:#7C8399;
  --rule:#DDE0EA;
  --dot:#E2E5EE;
  --cover:#1E2A63;
  --soft:#F2F3F9;
  --good:#0B7A4F;
  --warn:#9A5B00;
  --font:'Outfit',system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  --mono:'Overpass Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace;
}
@supports (color:color-mix(in srgb,#000 50%,#fff)){
  :root{--soft:color-mix(in srgb,var(--cover) 6%,#fff)}
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;font:400 16px/1.55 var(--font);color:var(--ink);background:var(--desk);-webkit-font-smoothing:antialiased}
h1,h2,h3,p,ul,ol,figure{margin:0}
button,input,textarea{font:inherit;color:inherit}
a{color:var(--cover)}
[hidden]{display:none!important}
:focus-visible{outline:3px solid color-mix(in srgb,var(--cover) 45%,#fff);outline-offset:2px;border-radius:6px}

/* ---------- buttons, fields ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font:600 15px/1 var(--font);padding:13px 20px;border-radius:999px;border:1.5px solid transparent;cursor:pointer;text-decoration:none;white-space:nowrap;transition:transform .12s ease,background .15s ease}
.btn:active{transform:translateY(1px)}
.btn.primary{background:var(--cover);color:#fff}
.btn.primary:hover{background:color-mix(in srgb,var(--cover) 88%,#000)}
.btn.line{background:#fff;border-color:var(--ink);color:var(--ink)}
.btn.line:hover{background:var(--soft)}
.btn.small{padding:9px 14px;font-size:13.5px}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.input{width:100%;background:#fff;border:1.5px solid var(--rule);border-radius:10px;padding:12px 14px;font:400 16px/1.5 var(--font)}
.input:focus{border-color:var(--cover);outline:3px solid color-mix(in srgb,var(--cover) 18%,transparent);outline-offset:0}
::placeholder{color:#A3A9BB}
kbd{font:500 .92em/1.3 var(--font);background:#fff;border:1px solid #C9CEDC;border-bottom-width:2px;border-radius:6px;padding:1px 7px;white-space:nowrap}
code{font:500 .9em var(--mono);background:var(--soft);padding:1px 6px;border-radius:5px}

/* ---------- first run ---------- */
.onb{min-height:100vh;min-height:100dvh;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)}
.onb-left{display:grid;place-items:center;padding:40px 24px;background:var(--desk)}
.onb-right{background:var(--page) radial-gradient(var(--dot) 1px,transparent 1.4px) 0 0/24px 24px;display:flex;flex-direction:column;justify-content:center;padding:clamp(28px,6vw,88px);gap:26px}
.nb{width:min(330px,64vw);aspect-ratio:10/14;position:relative;border-radius:6px 16px 16px 6px;background:var(--cover);color:#fff;transition:background-color .35s ease;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 34px 60px -34px color-mix(in srgb,var(--cover) 60%,#000),0 2px 6px rgba(22,26,46,.2)}
.nb::before{content:"";position:absolute;inset:0 auto 0 0;width:26px;border-radius:6px 0 0 6px;background:linear-gradient(90deg,rgba(0,0,0,.3),rgba(0,0,0,.07))}
.nb-band{position:absolute;top:-3px;bottom:-3px;right:38px;width:11px;border-radius:3px;background:color-mix(in srgb,var(--cover) 60%,#000)}
.nb-label{position:absolute;left:52px;right:70px;top:16%;background:#fff;color:var(--ink);border-radius:4px;padding:13px 15px 15px;box-shadow:0 1px 2px rgba(0,0,0,.25)}
.nb-label small{display:block;font:600 11px/1.2 var(--mono);color:var(--ink-3);letter-spacing:.02em}
.nb-label b{display:block;font:700 22px/1.15 var(--font);margin-top:6px;overflow-wrap:anywhere}
.nb-label span{display:block;font-size:13px;color:var(--ink-2);margin-top:4px}
.nb-objects{position:absolute;left:52px;right:70px;bottom:12%;display:flex;gap:12px}
.nb-objects div{flex:1;border:1.5px solid rgba(255,255,255,.6);border-radius:6px;padding:9px 10px;font:600 12px/1.3 var(--font)}
.nb-objects i{display:block;font:500 10.5px/1.2 var(--mono);opacity:.75;font-style:normal;margin-top:4px}
.onb h1{font:700 clamp(30px,3.6vw,44px)/1.08 var(--font);letter-spacing:-.02em}
.onb .lead{color:var(--ink-2);font-size:17px;max-width:520px}
.field{display:flex;flex-direction:column;gap:9px}
.field>label,.field>.lab{font-weight:600}
.choice{display:flex;gap:10px;flex-wrap:wrap}
.choice button{display:flex;flex-direction:column;align-items:flex-start;gap:3px;text-align:left;background:#fff;border:1.5px solid var(--rule);border-radius:12px;padding:12px 15px;cursor:pointer;min-width:170px;flex:1}
.choice button b{font-weight:700}
.choice button span{font-size:13.5px;color:var(--ink-2)}
.choice button[aria-pressed="true"]{border-color:var(--cover);box-shadow:0 0 0 2px var(--cover) inset;background:var(--soft)}
.swatches{display:flex;gap:10px}
.swatches button{width:30px;height:30px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1.5px var(--rule);cursor:pointer}
.swatches button[aria-pressed="true"]{box-shadow:0 0 0 2.5px var(--ink)}

/* ---------- the workbook ---------- */
.top{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--page) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--rule)}
.top-in{max-width:1180px;margin:0 auto;padding:12px 24px;display:flex;align-items:center;gap:16px}
.brand{display:flex;align-items:center;gap:10px;font-weight:700}
.brand i{width:14px;height:20px;border-radius:2px 5px 5px 2px;background:var(--cover);display:inline-block}
.brand small{font:500 12.5px var(--mono);color:var(--ink-3);margin-left:4px}
.seg{margin-left:auto;display:flex;background:var(--soft);border-radius:999px;padding:3px}
.seg button{border:0;background:transparent;border-radius:999px;padding:7px 14px;font-weight:600;font-size:14px;cursor:pointer;color:var(--ink-2)}
.seg button[aria-pressed="true"]{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(22,26,46,.15)}
.wrap{max-width:1180px;margin:0 auto;padding:28px 24px 80px;display:grid;grid-template-columns:250px minmax(0,1fr);gap:32px;align-items:start}
.rail{position:sticky;top:76px;display:flex;flex-direction:column;gap:2px}
.rail a{display:grid;grid-template-columns:28px 1fr;align-items:center;gap:10px;padding:9px 10px;border-radius:10px;text-decoration:none;color:var(--ink-2);font-weight:500}
.rail a b{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font:700 13px var(--mono);border:1.5px solid var(--rule);background:#fff;color:var(--ink-2)}
.rail a.done b{background:var(--good);border-color:var(--good);color:#fff}
.rail a.on{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(22,26,46,.08)}
.rail a.on b{border-color:var(--cover);color:var(--cover)}
.rail .part{font:600 11.5px var(--mono);color:var(--ink-3);letter-spacing:.04em;padding:16px 10px 6px}
.rail .part:first-child{padding-top:0}
.sheet{background:var(--page);border-radius:18px;box-shadow:0 1px 2px rgba(22,26,46,.06),0 18px 40px -28px rgba(22,26,46,.35);padding:clamp(22px,4vw,46px)}
.hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:26px;align-items:end;margin-bottom:6px}
.eyebrow{font:600 12.5px var(--mono);color:var(--cover)}
.hero h1{font:700 clamp(28px,3.3vw,40px)/1.08 var(--font);letter-spacing:-.02em;margin-top:8px}
.hero p{color:var(--ink-2);margin-top:12px;max-width:620px;font-size:17px}
.outputs{display:flex;gap:12px}
.outputs figure{width:150px;border:1.5px solid var(--rule);border-radius:12px;padding:10px;background:#fff}
.outputs figcaption{font:600 12px var(--mono);color:var(--ink-2);margin-top:8px}
.mini-deck{aspect-ratio:16/9;border-radius:6px;background:var(--cover);position:relative;overflow:hidden}
.mini-deck::before{content:"";position:absolute;left:10%;top:22%;width:55%;height:10%;background:#fff;border-radius:2px}
.mini-deck::after{content:"";position:absolute;left:10%;top:42%;width:38%;height:6%;background:rgba(255,255,255,.55);border-radius:2px;box-shadow:0 14px 0 rgba(255,255,255,.55)}
.mini-site{aspect-ratio:16/9;border-radius:6px;background:#fff;border:1.5px solid var(--rule);position:relative;overflow:hidden}
.mini-site::before{content:"";position:absolute;left:0;right:0;top:0;height:14%;background:var(--soft)}
.mini-site::after{content:"";position:absolute;left:12%;top:34%;width:46%;height:9%;background:var(--ink);border-radius:2px;box-shadow:0 18px 0 -4px var(--rule),46px 40px 0 -2px var(--cover)}

.step{border-top:1px solid var(--rule);padding-top:30px;margin-top:34px;scroll-margin-top:84px}
.step-h{display:flex;align-items:flex-start;gap:16px}
.num{flex:none;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font:700 16px var(--mono);background:var(--cover);color:#fff}
.step.is-done .num{background:var(--good)}
.step h2{font:700 24px/1.2 var(--font);letter-spacing:-.01em}
.step .why{color:var(--ink-2);margin-top:6px;max-width:660px}
.step-b{margin-left:56px;margin-top:18px;display:flex;flex-direction:column;gap:16px}
.step-b>p,.step-b li{max-width:700px}
.step-b ol{padding-left:22px;display:flex;flex-direction:column;gap:6px}
.clicks{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:14.5px}
.clicks i{color:var(--ink-3);font-style:normal}
.note{background:var(--soft);border-radius:12px;padding:13px 16px;font-size:15px;color:var(--ink-2);max-width:700px}
.note b{color:var(--ink)}
.note.warn{background:#FFF6E6;color:#5C4210}
.copy{border:1.5px solid var(--rule);border-radius:14px;overflow:hidden;max-width:760px;background:#fff}
.copy-h{display:flex;align-items:center;gap:10px;padding:9px 10px 9px 16px;background:var(--soft);border-bottom:1px solid var(--rule)}
.copy-h span{font:600 12.5px var(--mono);color:var(--ink-2)}
.copy-h .btn{margin-left:auto}
.copy pre{margin:0;padding:15px 16px;white-space:pre-wrap;word-break:break-word;font:400 14.5px/1.6 var(--mono);max-height:340px;overflow:auto}
.checks{display:flex;flex-direction:column;gap:8px;max-width:700px}
.tick{display:flex;gap:11px;align-items:flex-start;cursor:pointer;font-size:15.5px}
.tick input{width:19px;height:19px;margin-top:3px;accent-color:var(--good);flex:none}
details.fix{max-width:700px;border:1px solid var(--rule);border-radius:12px;padding:10px 14px}
details.fix summary{cursor:pointer;font-weight:600;font-size:15px}
details.fix ul{margin-top:8px;padding-left:20px;font-size:15px;color:var(--ink-2);display:flex;flex-direction:column;gap:6px}
.kit{display:flex;align-items:center;gap:18px;flex-wrap:wrap;border:1.5px dashed var(--rule);border-radius:14px;padding:16px;max-width:760px}
.tree{font:500 13.5px/1.7 var(--mono);color:var(--ink-2);white-space:pre;margin:0}
.formline{display:flex;gap:10px;max-width:760px;flex-wrap:wrap}
.formline .input{flex:1;min-width:240px}
.credits{margin-top:44px;border-top:1px solid var(--rule);padding-top:18px;font-size:13.5px;color:var(--ink-3)}
.credits a{color:var(--ink-2)}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-weight:600;font-size:14.5px;opacity:0;transition:.2s;pointer-events:none;z-index:20}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media (max-width:900px){
  .onb{grid-template-columns:1fr}
  .onb-left{padding:28px 20px 0;background:var(--page)}
  .nb{width:min(220px,50vw)}
  .wrap{grid-template-columns:1fr}
  .rail{display:none}
  .hero{grid-template-columns:1fr}
  .step-b{margin-left:0}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
@media print{.top,.rail,.btn{display:none!important}body{background:#fff}.sheet{box-shadow:none}}

</style>
</head>
<body>
<div id="root"></div>
<noscript><p style="padding:24px;font-family:sans-serif">This workbook needs JavaScript. Open it in Chrome, Safari, Edge or Firefox.</p></noscript>
<script>
/* The two skills, embedded verbatim from real-skills/ (fetched 2026-10-28). */
const SKILLS = [{"id": "investor-pitch-deck", "title": "Investor pitch deck", "author": "Mohit Aggarwal", "license": "MIT", "repo": "mohitagw15856/pm-claude-skills", "url": "https://github.com/mohitagw15856/pm-claude-skills/tree/d11af08fd758f1d25e98b16b08a4d99cea54b980/skills/investor-pitch-deck", "files": {"SKILL.md": "---\nname: investor-pitch-deck\ndescription: \"Build the narrative and slide structure for an investor pitch deck. Use when asked to create a pitch deck, investor presentation, fundraising deck, or startup pitch. Produces a slide-by-slide structure with narrative beats, key messages, and what each slide must prove to an investor.\"\n---\n\n# Investor Pitch Deck Skill\n\nBuilds the complete narrative and slide structure for an investor pitch deck — focused on what investors need to see, not what founders want to show.\n\n## Required Inputs\n- **Company name and one-line description**\n- **Stage** (Pre-seed / Seed / Series A / Series B)\n- **Ask** (how much raising and what for)\n- **Key metrics** (revenue, growth, users, retention)\n- **Target investors** (generalist / sector-specific / angels)\n- **Deck length** (10 / 12 / 15 slides)\n\n## Output Structure\n\nFor each slide:\n- **What this slide must prove** (the investor question it answers)\n- **Content guidance** (specific, not generic)\n- **Common mistake to avoid**\n\n---\n\n**Slide 1: Cover** — Proves you can say what you do in one sentence.\n**Slide 2: Problem** — Proves the problem is real, painful, and large. Lead with the human problem, not market size.\n**Slide 3: Solution** — Proves your solution is meaningfully better. Focus on outcome, not features.\n**Slide 4: Product** — Proves this is real and works. Show the actual product.\n**Slide 5: Traction** — Proves people want this. Show retention and revenue, not signups.\n**Slide 6: Market** — Proves the market is large enough. Use bottoms-up TAM where possible.\n**Slide 7: Business Model** — Proves you understand unit economics. Include CAC and LTV.\n**Slide 8: Go-To-Market** — Proves you can acquire customers efficiently. Focus on what is actually working.\n**Slide 9: Competition** — Proves you understand the landscape. Never say \"no competitors.\"\n**Slide 10: Team** — Proves this team can execute this opportunity. One sentence per person, specific.\n**Slide 11: Financials** — Proves you understand your business. Show assumptions, not just projections.\n**Slide 12: The Ask** — Proves you know exactly what you need. Specific use of funds and 18-month milestones.\n\n## Narrative Principles\n- Every slide answers one investor question\n- Investors decide go/no-go on slides 1-5 — front-load evidence\n- Keep to 10-12 slides for a first meeting\n\n## Quality Checks\n\n- [ ] Each slide answers one specific investor question\n- [ ] Slides 1-5 front-load the strongest evidence\n- [ ] Traction slide shows retention and revenue, not just signups\n- [ ] Competition slide does not say \"no competitors\"\n- [ ] Ask slide specifies use of funds and 18-month milestones\n- [ ] TAM is bottoms-up where possible\n\n## Anti-Patterns\n\n- [ ] Do not include a \"no real competitors\" slide — every company has competition and investors will discount founders who claim otherwise\n- [ ] Do not use a top-down TAM calculation without a bottoms-up validation — investors distrust pure top-down market sizing\n- [ ] Do not leave the ask vague — specify the amount, use of funds, and 18-month milestones the funding enables\n- [ ] Do not let traction slides show vanity metrics — focus on revenue, retention, and growth rate over downloads and signups\n- [ ] Do not bury the problem slide — investors must understand and feel the pain before they care about the solution\n\n## Example Trigger Phrases\n- \"Build a pitch deck structure for [company]\"\n- \"Help me structure my Series A deck\"\n- \"What slides should my investor pitch have?\"\n"}}, {"id": "frontend-design", "title": "Frontend design", "author": "Anthropic", "license": "Apache-2.0", "repo": "anthropics/skills", "url": "https://github.com/anthropics/skills/tree/dbd4588f9e1033efb41dad4bef2f7947c8993d44/skills/frontend-design", "files": {"LICENSE.txt": "\n                                 Apache License\n                           Version 2.0, January 2004\n                        http://www.apache.org/licenses/\n\n   TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION\n\n   1. Definitions.\n\n      \"License\" shall mean the terms and conditions for use, reproduction,\n      and distribution as defined by Sections 1 through 9 of this document.\n\n      \"Licensor\" shall mean the copyright owner or entity authorized by\n      the copyright owner that is granting the License.\n\n      \"Legal Entity\" shall mean the union of the acting entity and all\n      other entities that control, are controlled by, or are under common\n      control with that entity. For the purposes of this definition,\n      \"control\" means (i) the power, direct or indirect, to cause the\n      direction or management of such entity, whether by contract or\n      otherwise, or (ii) ownership of fifty percent (50%) or more of the\n      outstanding shares, or (iii) beneficial ownership of such entity.\n\n      \"You\" (or \"Your\") shall mean an individual or Legal Entity\n      exercising permissions granted by this License.\n\n      \"Source\" form shall mean the preferred form for making modifications,\n      including but not limited to software source code, documentation\n      source, and configuration files.\n\n      \"Object\" form shall mean any form resulting from mechanical\n      transformation or translation of a Source form, including but\n      not limited to compiled object code, generated documentation,\n      and conversions to other media types.\n\n      \"Work\" shall mean the work of authorship, whether in Source or\n      Object form, made available under the License, as indicated by a\n      copyright notice that is included in or attached to the work\n      (an example is provided in the Appendix below).\n\n      \"Derivative Works\" shall mean any work, whether in Source or Object\n      form, that is based on (or derived from) the Work and for which the\n      editorial revisions, annotations, elaborations, or other modifications\n      represent, as a whole, an original work of authorship. For the purposes\n      of this License, Derivative Works shall not include works that remain\n      separable from, or merely link (or bind by name) to the interfaces of,\n      the Work and Derivative Works thereof.\n\n      \"Contribution\" shall mean any work of authorship, including\n      the original version of the Work and any modifications or additions\n      to that Work or Derivative Works thereof, that is intentionally\n      submitted to Licensor for inclusion in the Work by the copyright owner\n      or by an individual or Legal Entity authorized to submit on behalf of\n      the copyright owner. For the purposes of this definition, \"submitted\"\n      means any form of electronic, verbal, or written communication sent\n      to the Licensor or its representatives, including but not limited to\n      communication on electronic mailing lists, source code control systems,\n      and issue tracking systems that are managed by, or on behalf of, the\n      Licensor for the purpose of discussing and improving the Work, but\n      excluding communication that is conspicuously marked or otherwise\n      designated in writing by the copyright owner as \"Not a Contribution.\"\n\n      \"Contributor\" shall mean Licensor and any individual or Legal Entity\n      on behalf of whom a Contribution has been received by Licensor and\n      subsequently incorporated within the Work.\n\n   2. Grant of Copyright License. Subject to the terms and conditions of\n      this License, each Contributor hereby grants to You a perpetual,\n      worldwide, non-exclusive, no-charge, royalty-free, irrevocable\n      copyright license to reproduce, prepare Derivative Works of,\n      publicly display, publicly perform, sublicense, and distribute the\n      Work and such Derivative Works in Source or Object form.\n\n   3. Grant of Patent License. Subject to the terms and conditions of\n      this License, each Contributor hereby grants to You a perpetual,\n      worldwide, non-exclusive, no-charge, royalty-free, irrevocable\n      (except as stated in this section) patent license to make, have made,\n      use, offer to sell, sell, import, and otherwise transfer the Work,\n      where such license applies only to those patent claims licensable\n      by such Contributor that are necessarily infringed by their\n      Contribution(s) alone or by combination of their Contribution(s)\n      with the Work to which such Contribution(s) was submitted. If You\n      institute patent litigation against any entity (including a\n      cross-claim or counterclaim in a lawsuit) alleging that the Work\n      or a Contribution incorporated within the Work constitutes direct\n      or contributory patent infringement, then any patent licenses\n      granted to You under this License for that Work shall terminate\n      as of the date such litigation is filed.\n\n   4. Redistribution. You may reproduce and distribute copies of the\n      Work or Derivative Works thereof in any medium, with or without\n      modifications, and in Source or Object form, provided that You\n      meet the following conditions:\n\n      (a) You must give any other recipients of the Work or\n          Derivative Works a copy of this License; and\n\n      (b) You must cause any modified files to carry prominent notices\n          stating that You changed the files; and\n\n      (c) You must retain, in the Source form of any Derivative Works\n          that You distribute, all copyright, patent, trademark, and\n          attribution notices from the Source form of the Work,\n          excluding those notices that do not pertain to any part of\n          the Derivative Works; and\n\n      (d) If the Work includes a \"NOTICE\" text file as part of its\n          distribution, then any Derivative Works that You distribute must\n          include a readable copy of the attribution notices contained\n          within such NOTICE file, excluding those notices that do not\n          pertain to any part of the Derivative Works, in at least one\n          of the following places: within a NOTICE text file distributed\n          as part of the Derivative Works; within the Source form or\n          documentation, if provided along with the Derivative Works; or,\n          within a display generated by the Derivative Works, if and\n          wherever such third-party notices normally appear. The contents\n          of the NOTICE file are for informational purposes only and\n          do not modify the License. You may add Your own attribution\n          notices within Derivative Works that You distribute, alongside\n          or as an addendum to the NOTICE text from the Work, provided\n          that such additional attribution notices cannot be construed\n          as modifying the License.\n\n      You may add Your own copyright statement to Your modifications and\n      may provide additional or different license terms and conditions\n      for use, reproduction, or distribution of Your modifications, or\n      for any such Derivative Works as a whole, provided Your use,\n      reproduction, and distribution of the Work otherwise complies with\n      the conditions stated in this License.\n\n   5. Submission of Contributions. Unless You explicitly state otherwise,\n      any Contribution intentionally submitted for inclusion in the Work\n      by You to the Licensor shall be under the terms and conditions of\n      this License, without any additional terms or conditions.\n      Notwithstanding the above, nothing herein shall supersede or modify\n      the terms of any separate license agreement you may have executed\n      with Licensor regarding such Contributions.\n\n   6. Trademarks. This License does not grant permission to use the trade\n      names, trademarks, service marks, or product names of the Licensor,\n      except as required for reasonable and customary use in describing the\n      origin of the Work and reproducing the content of the NOTICE file.\n\n   7. Disclaimer of Warranty. Unless required by applicable law or\n      agreed to in writing, Licensor provides the Work (and each\n      Contributor provides its Contributions) on an \"AS IS\" BASIS,\n      WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or\n      implied, including, without limitation, any warranties or conditions\n      of TITLE, NON-INFRINGEMENT, MERCHANTABILITY, or FITNESS FOR A\n      PARTICULAR PURPOSE. You are solely responsible for determining the\n      appropriateness of using or redistributing the Work and assume any\n      risks associated with Your exercise of permissions under this License.\n\n   8. Limitation of Liability. In no event and under no legal theory,\n      whether in tort (including negligence), contract, or otherwise,\n      unless required by applicable law (such as deliberate and grossly\n      negligent acts) or agreed to in writing, shall any Contributor be\n      liable to You for damages, including any direct, indirect, special,\n      incidental, or consequential damages of any character arising as a\n      result of this License or out of the use or inability to use the\n      Work (including but not limited to damages for loss of goodwill,\n      work stoppage, computer failure or malfunction, or any and all\n      other commercial damages or losses), even if such Contributor\n      has been advised of the possibility of such damages.\n\n   9. Accepting Warranty or Additional Liability. While redistributing\n      the Work or Derivative Works thereof, You may choose to offer,\n      and charge a fee for, acceptance of support, warranty, indemnity,\n      or other liability obligations and/or rights consistent with this\n      License. However, in accepting such obligations, You may act only\n      on Your own behalf and on Your sole responsibility, not on behalf\n      of any other Contributor, and only if You agree to indemnify,\n      defend, and hold each Contributor harmless for any liability\n      incurred by, or claims asserted against, such Contributor by reason\n      of your accepting any such warranty or additional liability.\n\n   END OF TERMS AND CONDITIONS\n", "SKILL.md": "---\nname: frontend-design\ndescription: Guidance for distinctive, intentional visual design when building new UI or reshaping an existing one. Helps with aesthetic direction, typography, and making choices that don't read as templated defaults.\nlicense: Complete terms in LICENSE.txt\n---\n\n# Frontend Design\n\nApproach this as the design lead at a design studio known for giving every client a distinct visual identity that is not mistaken for anyone else's. This client has already rejected proposals that felt cliché or templated, and is paying for a distinctive point of view: make deliberate, opinionated choices about palette, typography, and layout that are specific to this brief, and take aesthetic risk if justified.\n\n## Ground your designs in the subject matter\n\nIf the brief does not identify what the product or subject matter is, identify it yourself before designing, and confirm with the client. You can come up with one concrete subject, the design's audience, and the design's primary job, as a proposal. If there's any information in your memory about the client's preferences or context about what they're building, use that as a hint. The subject's industry, subject matter, materials, and vernacular are where distinctive visual choices come from — a design for a toy for girls aged 8–11 will be very aesthetically different from a dashboard for financial analysts. Build with the brief's real content and subject matter throughout.\n\n## Design principles\n\nFor web designs, the hero is the first thing viewers will see. Open with the most characteristic thing in the subject's world, in the form that is most appropriate: a headline, an image, an animation, a live demo, an interactive moment, or other treatments. Be deliberate with your choice: a big number with a small label, supporting stats, and a gradient accent is the default treatment, so only use it if that's truly the best option.\n\nTypography carries the personality of the page. You don't need a different typeface for display or headline text and body content: use one family or two, and if two, make them clearly distinct.\n\nChoose your typefaces deliberately, not the default families you would reach for on any other project, and set a clear type scale following the default guidance of The Elements of Typographic Style with intentional weights, widths, and spacing. When type is used as a headline or visual element, use the type treatment itself as an active part of the design, not a neutral delivery vehicle for the content.\n\nDefault to line lengths of less than 80 characters. Serif typefaces can have slightly longer line lengths; give serif body text slightly more line-height than a sans-serif.\n\nAvoid these default typographic treatments; they are the commonest tells of a generated page:\n- Accenting just a single word or phrase in a headline, like putting one word in italic/bold or a different color.\n- Using all caps for labels.\n- Adding unnecessary typographic labels above content.\n\nVisual structure is information. Structural devices like outlines, borders, numbering, eyebrows, dividers, labels, etc., encode useful information about the content rather than decorate it. Many generic designs use numbered markers (01 / 02 / 03), but that's only appropriate if the content actually is a sequence — like a stepped process or a timeline. Before adding numbered markers, check the content really is a sequence.\n\nUse non-user-triggered motion sparingly and deliberately, only to draw attention. A single orchestrated moment — one page-load sequence or one reveal — lands better than scattered effects; fade-and-slide-up entrances on each section and hover transitions on every card are the generic default and read as AI-generated. Motion that answers a person's action (opening, expanding, confirming) is welcome when it shows what changed.\n\nConsider written content carefully. Often a design brief may not contain real content, and it's up to you to come up with copy and placeholder content. Copy can make a design feel as templated as the design itself. See the below section on writing for more guidance.\n\n## Process: plan, review against the brief, build, critique\n\nFor calibration, AI-generated design right now clusters around some traits:\n1. a warm cream background (near #F4F1EA) with a high-contrast serif display and a terracotta or warm-clay accent (often near #D97757 — Anthropic's own Claude-interaction accent, so on a user's brief it reads as a tell);\n2. a near-black background with a single bright acid-green or vermilion accent;\n3. a broadsheet-style layout with hairline rules, zero border-radius, and dense newspaper-like columns;\n4. the SaaS-card kit: content chopped into identical rounded cards, one border-radius on everything regardless of hierarchy, the same soft grey shadow (rgba(0,0,0,.1)) under each, and gradient washes as decoration;\n5. template chrome that appears whatever the subject: a tracked-out ALL-CAPS eyebrow label above every heading; meta strings joined with middle dots ('A · B · C'); labels built as 'WORD — fragment' with a spaced em dash; tinted near-black (#0B0B0B, #111) standing in for black; a monospace face for small data labels; a '→' appended to link and button text.\n\nAll traits are legitimate for some briefs, but they are defaults rather than choices, and they appear regardless of subject. Where the brief pins down a visual direction, follow it exactly — the brief's own words always win, including when it asks for one of these looks. Where it leaves an axis free, don't spend that freedom on one of these defaults. As with a hired human designer, there's often a careful balance between doing what you're good at and taking each project as a chance to experiment and learn.\n\nWork in two passes. First, brainstorm a short design plan based on the client's design brief: create a compact token system with color, type, layout, and principles.\n- Color: describe the core base palette as 4–6 named hex values.\n- Type: the typefaces and their roles.\n- Layout: a layout concept, using one-sentence prose descriptions and ASCII wireframes to ideate and compare. Include alignment guidance; should the content be left aligned, center aligned, justified?\n- Principles: the high-level guidance for what makes this page unique.\n\nThen review that plan against the brief before building: if any part of it reads like the generic default you would produce for any similar page (work through a similar prompt to see if you arrive somewhere similar) rather than a choice made for this specific brief — revise that part, say what you changed and why. Only after you've confirmed the relative uniqueness of your design plan should you start to write the code, following the revised plan.\n\nWhen writing the code, be careful of structuring your CSS selector specificities. It's easy to generate CSS classes that cancel each other out (especially with a type-based selector like .section and an element-based selector like .cta). This can happen often with padding/margin between sections.\n\n## Restraint and self-critique\n\nSpend your boldness in one place. Let one element be the memorable thing, keep everything around it quiet and disciplined, and cut any decoration that does not serve the brief. Build to a quality floor without announcing it: responsive down to mobile, visible keyboard focus, reduced motion respected, visually accessible, harmonious color palettes. Critique your own work as you build, taking screenshots to review if your environment supports it — a picture is worth 1000 tokens. Consider Chanel's advice: before leaving the house, take a look in the mirror and remove one accessory. Human creatives have memory and always try to do something new, so if you have a space to quickly jot down notes about what you've tried, it can help you in future passes.\n\n## More on writing in design\n\nWords appear in a design for one reason: to make it easier to understand and use. They are design content, not decoration. Bring the same intentionality and minimalism to copywriting that you would bring to spacing and color. Before writing anything, ask what the design needs to say, and how it can best be said to help the person navigate the experience.\n\nWrite from the end user's perspective. Name things by what users will understand in simple language, not by how the system is built. A user manages notifications, not webhook config. Describe what something is or does in plain terms rather than selling it. Being specific and legible to new users is always better than being clever.\n\nUse active voice as default. A CTA says exactly what happens when it is used: \"Save changes,\" not \"Submit.\" An action keeps the same name through the whole flow, so the button that says \"Publish\" produces a toast that says \"Published.\" The vocabulary of an interface is the signposting for someone navigating the product. Cohesion and consistency are how people learn their way around.\n\nTreat failure and emptiness as moments for direction, not mood. Explain what went wrong and how to fix it, in the interface's voice rather than a person's. Errors don't apologize, and they are never vague about what happened. An empty screen is an invitation to act.\n\nKeep the tone conversational: plain verbs, sentence case, no filler, with tone matched to the brand and the audience. Let each written element do exactly one job.\n"}}];
/* Session 4 workbook: build a pitch deck and a landing page with Codex or Claude Code.
   Plain JavaScript, no dependencies. SKILLS (the two real skills) is prepended by build.py.
   State lives in localStorage under KEY; earlier session workbooks in the same browser lend the venture name and cover. */

const KEY = 'venturelab.build-workbook.v1';
const KEY_OLD = ['venturelab.routine-workbook.v1', 'venturelab.skill-workbook.v1', 'venturelab.workbook5.v1'];

const COVERS = [
  { id: 'navy', hex: '#1E2A63' }, { id: 'forest', hex: '#0E5F4A' }, { id: 'berry', hex: '#9B1F4B' },
  { id: 'violet', hex: '#5236AB' }, { id: 'petrol', hex: '#0B6477' }, { id: 'poppy', hex: '#C8371F' }
];

/* The two agents. Everything that differs between them lives here. */
const AGENTS = {
  codex: {
    name: 'Codex', where: 'in the ChatGPT desktop app', skills: '.agents/skills', call: '$', chat: 'chat',
    plan: 'Every ChatGPT plan, including Free and IE’s ChatGPT Edu.',
    get: ['chatgpt.com/download', 'Install the ChatGPT app for Mac or Windows', 'Sign in'],
    open: ['ChatGPT app', 'Codex', 'Open a folder (or Add project)', 'your build folder'],
    allow: 'When Codex asks for permission to edit files or run a command in this folder, allow it. Keep it limited to this folder.',
    newchat: 'start a new chat in the same folder'
  },
  claude: {
    name: 'Claude Code', where: 'in the Claude desktop app', skills: '.claude/skills', call: '/', chat: 'session',
    plan: 'Claude Pro or higher. The free plan does not include Code.',
    get: ['claude.com/download', 'Install the Claude app for Mac or Windows', 'Sign in'],
    open: ['Claude app', 'Code', 'Select folder', 'your build folder'],
    allow: 'When Claude asks for permission to edit files or run a command, allow it for this folder. “Accept edits” is fine; never skip every permission.',
    newchat: 'start a new session in the same folder'
  }
};

const fresh = () => ({ v: 1, onboarded: false, agent: 'codex', os: 'mac', cover: 'navy', venture: '', form: '', site: '', done: {} });
let storageOK = true;
function load() {
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) return Object.assign(fresh(), JSON.parse(raw));
    const s = fresh();
    for (const k of KEY_OLD) {           /* lend the venture name and cover from an earlier workbook */
      const o = JSON.parse(localStorage.getItem(k) || 'null');
      if (!o) continue;
      if (!s.venture && o.venture && o.venture.name) s.venture = o.venture.name;
      if (o.cover && COVERS.some(c => c.id === o.cover)) s.cover = o.cover;
      if (o.app === 'claude') s.agent = 'claude';
    }
    return s;
  } catch (e) { storageOK = false; return fresh(); }
}
let S = load();
function save() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) { storageOK = false; } }

const root = document.getElementById('root');
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const one = s => String(s || '').replace(/\s+/g, ' ').trim();
const V = () => one(S.venture) || 'our venture';
const A = () => AGENTS[S.agent];
const slug = s => (one(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'venture');
const folder = () => slug(S.venture) + '-build';
const cover = () => (COVERS.find(c => c.id === S.cover) || COVERS[0]).hex;
const clicks = path => `<div class="clicks">${path.map(p => `<kbd>${esc(p)}</kbd>`).join('<i>›</i>')}</div>`;
const skillTok = id => A().call + id;

function toast(msg) {
  const t = document.getElementById('toast'); if (!t) return;
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.remove('show'), 1900);
}
async function copyText(text) {
  try { await navigator.clipboard.writeText(text); return true; } catch (e) {
    const ta = document.createElement('textarea'); ta.value = text; ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
    document.body.appendChild(ta); ta.select(); let ok = false; try { ok = document.execCommand('copy'); } catch (_) { /* none */ }
    ta.remove(); return ok;
  }
}
function download(blob, filename) {
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = filename;
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000);
}

/* ---------- a zip file, written by hand (stored, not compressed) ---------- */
const CRC_TABLE = (() => { const t = new Uint32Array(256); for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();
function crc32(u8) { let c = 0xFFFFFFFF; for (let i = 0; i < u8.length; i++) c = CRC_TABLE[(c ^ u8[i]) & 0xFF] ^ (c >>> 8); return (c ^ 0xFFFFFFFF) >>> 0; }
function zipBytes(files) {
  const enc = new TextEncoder(), now = new Date();
  const time = (now.getHours() << 11) | (now.getMinutes() << 5) | (now.getSeconds() >> 1);
  const date = ((now.getFullYear() - 1980) << 9) | ((now.getMonth() + 1) << 5) | now.getDate();
  const parts = [], central = []; let offset = 0;
  files.forEach(f => {
    const name = enc.encode(f.path), data = enc.encode(f.text || ''), crc = crc32(data);
    const lh = new DataView(new ArrayBuffer(30));
    lh.setUint32(0, 0x04034b50, true); lh.setUint16(4, 20, true); lh.setUint16(6, 0x0800, true);
    lh.setUint16(10, time, true); lh.setUint16(12, date, true); lh.setUint32(14, crc, true);
    lh.setUint32(18, data.length, true); lh.setUint32(22, data.length, true); lh.setUint16(26, name.length, true);
    parts.push(new Uint8Array(lh.buffer), name, data);
    const ch = new DataView(new ArrayBuffer(46));
    ch.setUint32(0, 0x02014b50, true); ch.setUint16(4, 20, true); ch.setUint16(6, 20, true); ch.setUint16(8, 0x0800, true);
    ch.setUint16(12, time, true); ch.setUint16(14, date, true); ch.setUint32(16, crc, true);
    ch.setUint32(20, data.length, true); ch.setUint32(24, data.length, true); ch.setUint16(28, name.length, true);
    ch.setUint32(38, f.path.endsWith('/') ? 0x10 : 0, true); ch.setUint32(42, offset, true);
    central.push(new Uint8Array(ch.buffer), name);
    offset += 30 + name.length + data.length;
  });
  const cdSize = central.reduce((n, p) => n + p.length, 0);
  const end = new DataView(new ArrayBuffer(22));
  end.setUint32(0, 0x06054b50, true); end.setUint16(8, files.length, true); end.setUint16(10, files.length, true);
  end.setUint32(12, cdSize, true); end.setUint32(16, offset, true);
  return [...parts, ...central, new Uint8Array(end.buffer)];
}

/* ---------- what goes in the build folder ---------- */
function ventureTemplate() {
  return `# ${V()}

Everything the pitch deck and the landing page are built from. Write "Unknown" where you don't know yet.
Never put a number here that you can't back up.

## One line
What we do, for whom.

## Problem
Who has it, how often, and what it costs them today.

## Customer
The first customer group we are going after.

## Solution and product
What we built or are building, and how it works.

## Traction and evidence
Interviews, users, pilots, revenue, waitlist. Only real numbers, with dates.

## Market
Who could buy this, counted from the bottom up where possible.

## Business model and pricing
Who pays, how much, how often.

## Competitors and alternatives
What customers use today instead of us.

## Team
One line per person: name, role, why them.

## The ask
How much we are raising, what it pays for, and what we will have achieved in 18 months.

## Links
Website, demo, waitlist form.
`;
}
function readme() {
  const a = A();
  return `# ${V()} build folder

Open this whole folder in ${a.name} (${a.where}). It is where the agent works:
it reads venture.md, installs the skills from kit/skills, and writes deck/ and site/.

  venture.md   the facts the deck and the site are built from
  kit/skills/  two published skills, unchanged:
               investor-pitch-deck  by Mohit Aggarwal (MIT)  github.com/mohitagw15856/pm-claude-skills
               frontend-design      by Anthropic (Apache-2.0) github.com/anthropics/skills
  deck/        your pitch deck, made by the agent
  site/        your landing page, made by the agent
`;
}
function kitZip() {
  const base = folder() + '/';
  const files = [{ path: base }, { path: base + 'kit/' }, { path: base + 'kit/skills/' },
    { path: base + 'README.md', text: readme() }, { path: base + 'venture.md', text: ventureTemplate() }];
  SKILLS.forEach(k => {
    files.push({ path: base + 'kit/skills/' + k.id + '/' });
    Object.keys(k.files).forEach(f => files.push({ path: base + 'kit/skills/' + k.id + '/' + f, text: k.files[f] }));
  });
  return new Blob(zipBytes(files), { type: 'application/zip' });
}

/* ---------- the prompts ---------- */
const P = {
  install: () => `This folder has two skills in kit/skills: investor-pitch-deck and frontend-design.

Install both as project skills for this folder: copy each skill folder, unchanged, to ${A().skills}/<skill name>/ (create ${A().skills} if it doesn't exist). Don't edit the SKILL.md files.

Then tell me which skills you can now use. If you can't see the new ones yet, tell me to ${A().newchat}.`,

  chatAsk: () => `Write everything you know about ${V()} as Markdown, under these headings: One line, Problem, Customer, Solution and product, Traction and evidence, Market, Business model and pricing, Competitors and alternatives, Team, The ask, Links.

Use what you already have on file about ${V()} (memory, our venture skill, past chats). Write "Unknown" where you don't know. Don't invent numbers, customers or quotes.`,

  venture: () => `Fill in venture.md for ${V()}.

If I paste text below, use it first and put each part under the right heading. Then interview me for what is still missing: one question at a time, at most eight questions, and skip anything I already answered. Write "Unknown" where I don't know. Never invent numbers, customers, quotes or team members.

When you're done, show me the finished file.

[Paste what ChatGPT or Claude wrote here, or delete this line]`,

  deck: () => `Use the investor-pitch-deck skill (${skillTok('investor-pitch-deck')}) and venture.md to make the pitch deck for ${V()}.

1. First show me the slide-by-slide plan from the skill (what each slide must prove), as a short list, and what is missing from venture.md. Ask me at most three questions, then wait for my answers.
2. Then build it as deck/index.html: one self-contained HTML file that works offline. 16:9 slides, one per screen, 10 to 12 slides. Arrow keys and the space bar move between slides, the slide number sits in a corner, and printing gives one slide per page so I can save a PDF. Each slide has speaker notes, hidden until I press N.
3. Use the frontend-design skill (${skillTok('frontend-design')}) for the look: choose a visual direction that fits ${V()}, not a generic template. One idea per slide, few words, large type.
4. Never invent numbers, customers, quotes or logos. Where a fact is missing, put it on the slide in brackets, like [TO CONFIRM: monthly revenue], so we can find it later.
5. When it's done, open it in my browser and tell me the three weakest slides and why.`,

  site: () => `Use the frontend-design skill (${skillTok('frontend-design')}) and venture.md to build the landing page for ${V()} as site/index.html: one self-contained HTML file that works on phones.

Sections: a headline that says what we do and for whom, the problem, how it works in three steps, who it's for, a waitlist call to action, three short FAQs, and a footer.

The waitlist: every "Join the waitlist" button opens this form in a new tab: ${one(S.form) || '[PASTE YOUR FORM LINK]'}

Match the visual direction of deck/index.html so the deck and the site look like one company. Never invent numbers, testimonials, customer logos or press mentions; leave a section out if there is nothing true to put in it. Open the page in my browser when it's done.`,

  link: () => `Our landing page is live at ${one(S.site) || '[PASTE YOUR LIVE LINK]'}.
Add it to the last slide of deck/index.html and to the Links section of venture.md, then open the deck again.`
};

const MORE = [
  'Make slide 2 (the problem) hit harder: open with one real customer moment from venture.md.',
  'Turn the [TO CONFIRM] brackets into a checklist file, todo.md, with who on the team should find each fact.',
  'Make a Spanish version of the landing page as site/es.html, with a language switch on both pages.',
  'Write the executive summary that goes with the deck, as exec-summary.html, one printed page.'
];

/* ---------- steps ---------- */
const STEPS = [
  { id: 'app', part: 'Set up', t: 'Open the app', why: () => `${A().name} is an AI that works inside a folder on your computer: it reads files, writes new ones and runs them. ${A().plan}` },
  { id: 'folder', part: 'Set up', t: 'Get your build folder', why: () => 'One zip with everything the agent needs: the two skills, a fact sheet about your venture, and room for the deck and the site.' },
  { id: 'skills', part: 'Set up', t: 'Install the two skills', why: () => 'A skill you hand over as a file. The agent copies it into its own skills folder, so every chat in this folder can use it.' },
  { id: 'venture', part: 'Set up', t: 'Tell it about your venture', why: () => 'Everything it builds comes from venture.md. A few minutes here decide how good the deck and the site are.' },
  { id: 'deck', part: 'Build', t: 'Build the pitch deck', why: () => 'The investor-pitch-deck skill gives the story, slide by slide. The frontend-design skill gives the look.' },
  { id: 'site', part: 'Build', t: 'Build the landing page', why: () => 'A one-page site with a waitlist, in the same look as the deck. Every signup is traction you can put on the deck.' },
  { id: 'live', part: 'Build', t: 'Put it online', why: () => 'Drag the site folder onto a page and you have a public link to share. Free, and no install.' }
];

function copyBox(key, text, label) {
  return `<div class="copy"><div class="copy-h"><span>${esc(label)}</span><button class="btn small primary" data-copy="${key}">Copy</button></div><pre>${esc(text)}</pre></div>`;
}
const tick = (id, label) => `<label class="tick"><input type="checkbox" data-done="${id}" ${S.done[id] ? 'checked' : ''}><span>${label}</span></label>`;
const fix = items => `<details class="fix"><summary>If it goes wrong</summary><ul>${items.map(i => `<li>${i}</li>`).join('')}</ul></details>`;

function stepBody(s) {
  const a = A(), win = S.os === 'win';
  switch (s.id) {
    case 'app': return `
      ${clicks(a.get)}
      <p>Then open it on your build folder (you get the folder in step 2):</p>
      ${clicks(a.open)}
      ${S.agent === 'claude' && win ? `<p class="note warn"><b>Windows:</b> Claude Code needs Git for Windows. Install it from <code>git-scm.com</code>, then restart the Claude app.</p>` : ''}
      <p class="note">${esc(a.allow)}</p>
      <div class="checks">${tick('app-ready', `${a.name} is open and I’m signed in`)}</div>`;
    case 'folder': return `
      <div class="kit"><button class="btn primary" data-kit>Download ${esc(folder())}.zip</button>
<pre class="tree">${esc(folder())}/
  README.md
  venture.md
  kit/skills/investor-pitch-deck/
  kit/skills/frontend-design/</pre></div>
      <ol><li>${win ? 'Right-click the zip › <kbd>Extract All</kbd>.' : 'Double-click the zip to unzip it.'} Move the folder somewhere you’ll find it, like Documents.</li>
      <li>Open that folder in ${esc(a.name)}: ${clicks(a.open)}</li></ol>
      <div class="checks">${tick('folder-open', `${esc(a.name)} is working in ${esc(folder())}`)}</div>
      ${fix([`${esc(a.name)} shows a different folder: open the one that contains <code>venture.md</code>, not a folder above or inside it.`, 'The zip opened as a list of files instead of a folder: extract it first, then open the extracted folder.'])}`;
    case 'skills': return `
      <p>Paste this into ${esc(a.name)}:</p>
      ${copyBox('install', P.install(), `${a.name} · install the skills`)}
      <p class="note"><b>It will ask before writing into <code>${esc(a.skills)}</code>.</b> Allow it: that hidden folder is where ${esc(a.name)} keeps the skills it can use in this folder.</p>
      <div class="checks">${tick('skills-in', `It lists <b>investor-pitch-deck</b> and <b>frontend-design</b>`)}</div>
      ${fix([`It can’t see them: ${esc(a.newchat)}, then ask “Which skills can you use?”`, `It asks where skills go: <code>${esc(a.skills)}/investor-pitch-deck/SKILL.md</code> and <code>${esc(a.skills)}/frontend-design/SKILL.md</code>.`, 'It wants to change the skills: say no. They are published skills; we use them as they are.'])}`;
    case 'venture': return `
      <p><b>Fastest:</b> if ChatGPT or Claude already knows your venture (memory, your venture skill), ask it there first:</p>
      ${copyBox('chatAsk', P.chatAsk(), 'ChatGPT or Claude chat · what do you know?')}
      <p>Then paste its answer at the bottom of this prompt, in ${esc(a.name)}. No answer to paste? Delete the last line and it interviews you.</p>
      ${copyBox('venture', P.venture(), `${a.name} · fill venture.md`)}
      <div class="checks">${tick('venture-ok', 'venture.md is filled in, with “Unknown” where we don’t know yet')}</div>`;
    case 'deck': return `
      ${copyBox('deck', P.deck(), `${a.name} · build the deck`)}
      <p>Answer its three questions, then let it work. It takes a few minutes.</p>
      <div class="checks">
        ${tick('deck-open', '<b>deck/index.html</b> opens in my browser, 10 to 12 slides, arrow keys work')}
        ${tick('deck-true', 'Every number on it is real, or marked [TO CONFIRM]')}
        ${tick('deck-pdf', `Saved as PDF: <kbd>${win ? 'Ctrl' : '⌘'}+P</kbd> › Save as PDF`)}
      </div>
      <p class="note"><b>Change anything by asking.</b> “Slide 4 has too much text.” “Use our real logo from logo.png.” “The problem slide is weak, make it about one customer.” Each change is one message.</p>
      ${fix(['It built slides without asking questions: reply with the facts it missed, and ask it to update the deck.', 'Nothing opens: ask it “Open deck/index.html in my browser”, or double-click the file in the deck folder.', 'It made up a number: “Remove every number that is not in venture.md, mark them [TO CONFIRM]”.'])}`;
    case 'site': return `
      <p><b>First, the waitlist form</b> (two minutes):</p>
      ${clicks(['forms.google.com', 'Blank form', `Title: ${V()} waitlist`, 'Question: Email (Short answer, Required)', 'Send', 'Link', 'Copy'])}
      <div class="formline"><input class="input" id="form" placeholder="Paste your form link here, it goes into the prompt" value="${esc(S.form)}"></div>
      ${copyBox('site', P.site(), `${a.name} · build the landing page`)}
      <div class="checks">
        ${tick('site-open', '<b>site/index.html</b> opens, and looks right on a phone-size window')}
        ${tick('site-form', '“Join the waitlist” opens my form, and a test signup appears in the form’s Responses')}
      </div>`;
    case 'live': return `
      <ol><li>Go to <code>app.netlify.com/drop</code> and drag the <b>site</b> folder onto the page.</li>
      <li>You get a public link straight away. Create a free Netlify account and <b>claim</b> the site within the hour, or it expires.</li>
      <li>Paste the link here, then give the prompt to ${esc(a.name)} so the deck points to it.</li></ol>
      <div class="formline"><input class="input" id="site" placeholder="Your live link, like https://….netlify.app" value="${esc(S.site)}"></div>
      ${copyBox('link', P.link(), `${a.name} · add the link to the deck`)}
      <div class="checks">${tick('live-ok', 'The link opens on my phone, and I joined my own waitlist')}</div>
      <p class="note"><b>Keep going.</b> Same folder, one message each:</p>
      ${MORE.map((m, i) => copyBox('more' + i, m, `${a.name} · idea ${i + 1}`)).join('')}`;
  }
  return '';
}
const stepDone = s => {
  const keys = { app: ['app-ready'], folder: ['folder-open'], skills: ['skills-in'], venture: ['venture-ok'], deck: ['deck-open', 'deck-true'], site: ['site-open', 'site-form'], live: ['live-ok'] }[s.id];
  return keys.every(k => S.done[k]);
};

/* ---------- pages ---------- */
function onbHTML() {
  const a = AGENTS;
  return `<main class="onb">
    <div class="onb-left"><div class="nb"><div class="nb-band"></div>
      <div class="nb-label"><small>SESSION 4 OF 4 · BUILD</small><b>${esc(one(S.venture) || 'Your venture')}</b><span>A pitch deck and a landing page</span></div>
      <div class="nb-objects"><div>deck<i>index.html</i></div><div>site<i>index.html</i></div></div></div></div>
    <div class="onb-right">
      <div><h1>Today your AI builds two things</h1><p class="lead" style="margin-top:12px">A pitch deck and a landing page with a waitlist, from what it knows about your venture. It works in a folder on your computer.</p></div>
      <div class="field"><label for="vn">Your venture’s name</label><input class="input" id="vn" value="${esc(S.venture)}" placeholder="e.g. Rehearse" autocomplete="off"></div>
      <div class="field"><span class="lab">The app you’ll build with</span><div class="choice" data-pick="agent">
        <button data-v="codex" aria-pressed="${S.agent === 'codex'}"><b>Codex</b><span>In the ChatGPT app. Every plan, including Free.</span></button>
        <button data-v="claude" aria-pressed="${S.agent === 'claude'}"><b>Claude Code</b><span>In the Claude app. Claude Pro or higher.</span></button></div></div>
      <div class="field"><span class="lab">Your computer</span><div class="choice" data-pick="os">
        <button data-v="mac" aria-pressed="${S.os === 'mac'}"><b>Mac</b></button>
        <button data-v="win" aria-pressed="${S.os === 'win'}"><b>Windows</b></button></div></div>
      <div class="field"><span class="lab">Cover</span><div class="swatches">${COVERS.map(c => `<button data-cover="${c.id}" style="background:${c.hex}" aria-pressed="${S.cover === c.id}" aria-label="${c.id}"></button>`).join('')}</div></div>
      <div><button class="btn primary" id="go" ${one(S.venture) ? '' : 'disabled'}>Open the workbook</button></div>
      ${storageOK ? '' : '<p class="note warn">This browser blocks saving, so your answers are lost when you close the page.</p>'}
    </div></main>`;
}
function bookHTML() {
  const a = A(); let part = '';
  const rail = STEPS.map((s, i) => {
    const head = s.part !== part ? `<div class="part">${(part = s.part).toUpperCase()}</div>` : '';
    return head + `<a href="#${s.id}" class="${stepDone(s) ? 'done' : ''}" data-rail="${s.id}"><b>${stepDone(s) ? '✓' : i + 1}</b>${esc(s.t)}</a>`;
  }).join('');
  const steps = STEPS.map((s, i) => `<section class="step ${stepDone(s) ? 'is-done' : ''}" id="${s.id}">
      <div class="step-h"><div class="num">${stepDone(s) ? '✓' : i + 1}</div><div><h2>${esc(s.t)}</h2><p class="why">${esc(s.why())}</p></div></div>
      <div class="step-b">${stepBody(s)}</div></section>`).join('');
  return `<header class="top"><div class="top-in">
      <div class="brand"><i></i>${esc(V())}<small>Session 4 of 4 · Build</small></div>
      <div class="seg" role="group" aria-label="App">${Object.keys(AGENTS).map(k => `<button data-agent="${k}" aria-pressed="${S.agent === k}">${AGENTS[k].name}</button>`).join('')}</div>
      <div class="seg" role="group" aria-label="Computer"><button data-os="mac" aria-pressed="${S.os === 'mac'}">Mac</button><button data-os="win" aria-pressed="${S.os === 'win'}">Windows</button></div>
    </div></header>
    <div class="wrap"><nav class="rail" aria-label="Steps">${rail}</nav>
    <article class="sheet">
      <div class="hero"><div><div class="eyebrow">${esc(a.name)} · ${esc(a.where)}</div>
        <h1>A pitch deck and a landing page for ${esc(V())}</h1>
        <p>Seven steps. You give the AI two published skills and the facts about your venture; it builds both, and you check that every claim is true.</p></div>
        <div class="outputs"><figure><div class="mini-deck"></div><figcaption>deck/index.html</figcaption></figure><figure><div class="mini-site"></div><figcaption>site/index.html</figcaption></figure></div></div>
      ${steps}
      <div class="credits">Skills, unchanged: ${SKILLS.map(k => `<a href="${esc(k.url)}" target="_blank" rel="noopener">${esc(k.id)}</a> by ${esc(k.author)} (${esc(k.license)})`).join(' · ')}.
        <a href="#" data-reset>Change the venture or the app</a></div>
    </article></div>`;
}

function render() {
  document.documentElement.style.setProperty('--cover', cover());
  root.innerHTML = (S.onboarded ? bookHTML() : onbHTML()) + '<div id="toast" role="status" aria-live="polite"></div>';
}
const PROMPTS = () => Object.assign({ install: P.install(), chatAsk: P.chatAsk(), venture: P.venture(), deck: P.deck(), site: P.site(), link: P.link() },
  Object.fromEntries(MORE.map((m, i) => ['more' + i, m])));

root.addEventListener('click', async e => {
  const t = e.target.closest('button,a'); if (!t) return;
  if (t.closest('[data-pick]')) { S[t.closest('[data-pick]').dataset.pick] = t.dataset.v; save(); render(); return; }
  if (t.dataset.cover) { S.cover = t.dataset.cover; save(); render(); return; }
  if (t.id === 'go') { if (one(S.venture)) { S.onboarded = true; save(); render(); window.scrollTo(0, 0); } return; }
  if (t.dataset.agent) { S.agent = t.dataset.agent; save(); const y = window.scrollY; render(); window.scrollTo(0, y); return; }
  if (t.dataset.os) { S.os = t.dataset.os; save(); const y = window.scrollY; render(); window.scrollTo(0, y); return; }
  if (t.dataset.copy) { const ok = await copyText(PROMPTS()[t.dataset.copy]); toast(ok ? 'Copied. Paste it into ' + (t.dataset.copy === 'chatAsk' ? 'ChatGPT or Claude' : A().name) : 'Select the text and copy it'); return; }
  if (t.hasAttribute('data-kit')) { download(kitZip(), folder() + '.zip'); toast('Downloaded ' + folder() + '.zip'); return; }
  if (t.hasAttribute('data-reset')) { e.preventDefault(); S.onboarded = false; save(); render(); window.scrollTo(0, 0); }
});
root.addEventListener('input', e => {
  if (e.target.id === 'vn') { S.venture = e.target.value; save(); const go = document.getElementById('go'); if (go) go.disabled = !one(S.venture);
    const b = document.querySelector('.nb-label b'); if (b) b.textContent = one(S.venture) || 'Your venture'; }
  if (e.target.id === 'form' || e.target.id === 'site') {
    S[e.target.id] = e.target.value; save();
    const key = e.target.id === 'form' ? 'site' : 'link';
    const pre = document.querySelector(`[data-copy="${key}"]`)?.closest('.copy')?.querySelector('pre');
    if (pre) pre.textContent = PROMPTS()[key];
  }
});
root.addEventListener('change', e => {
  if (e.target.dataset.done) { S.done[e.target.dataset.done] = e.target.checked; save(); const y = window.scrollY; render(); window.scrollTo(0, y); }
});
root.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.id === 'vn' && one(S.venture)) { S.onboarded = true; save(); render(); } });
render();

</script>
</body>
</html>
